# Public, non-secret local URL. The Windows launcher sets this automatically.
# If starting Expo manually, use the laptop LAN URL below or the private Tailscale Serve HTTPS URL.
# The committed example never contains a real machine IP or tailnet name.
EXPO_PUBLIC_AGENTIC_OS_URL=http://YOUR_LAPTOP_LAN_IP:3000
# EXPO_PUBLIC_AGENTIC_OS_URL=https://YOUR_DEVICE.YOUR_TAILNET.ts.net
